<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RootNamespace>IsonGraph.Vector.Sqlite</RootNamespace>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\IsonGraph.Vector\IsonGraph.Vector.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.10" />
    <!-- Ships the native vec0 binaries per RID, under runtimes/{rid}/native.
         asg017's own sqlite-vec package has never left prerelease on NuGet
         (0.1.7-alpha.2.1 is its newest), and a stable 1.0.0 cannot depend on a
         prerelease - dotnet pack refuses it with NU5104. This is a
         redistribution of the same upstream C, at 0.1.9: the version the Rust,
         Node and C++ ports already use. Revisit if asg017 publishes a stable
         package. -->
    <PackageReference Include="HiraokaHyperTools.sqlite-vec" Version="0.1.9" />
  </ItemGroup>

  <PropertyGroup>
    <PackageId>IsonGraph.Vector.Sqlite</PackageId>
    <Version>1.0.0</Version>
    <Authors>Mahesh Vaikri</Authors>
    <Copyright>Copyright (c) 2026 ISON - Mahesh Vaikri</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/ISON-format/isongraph-vector</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageProjectUrl>https://graph.ison.dev/docs/isongraph-vector</PackageProjectUrl>
    <PackageTags>ison;graph;embeddings;semantic;vector;sqlite;sqlite-vec</PackageTags>
    <Description>SQLite-backed storage for IsonGraph.Vector, with sqlite-vec answering top-k searches. The schema matches every other isongraph-vector language port, so a database written by one can be opened by another.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
    <None Include="..\..\LICENSE" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
