{
  "name": "isongraph-vector-ts",
  "version": "1.0.0",
  "description": "ISONGraph Vector - semantic graph search for TypeScript: embedding similarity combined with graph traversal",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "test:core": "vitest run src/index.test.ts",
    "prepublishOnly": "npm run build",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "ison",
    "graph",
    "embeddings",
    "semantic",
    "vector"
  ],
  "author": "Mahesh Vaikri",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ISON-format/isongraph-vector.git",
    "directory": "isongraph-vector-ts"
  },
  "homepage": "https://github.com/ISON-format/isongraph-vector#readme",
  "bugs": {
    "url": "https://github.com/ISON-format/isongraph-vector/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "ison-graph-ts": "^1.4.0"
  },
  "devDependencies": {
    "@types/node": "^26.4.1",
    "typescript": "^5.3.0",
    "vitest": "^4.1.10"
  },
  "optionalDependencies": {
    "sqlite-vec": "^0.1.9"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./sqlite": {
      "types": "./dist/sqlite-store.d.ts",
      "default": "./dist/sqlite-store.js"
    }
  }
}
